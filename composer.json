{
    "name": "kesha1225/kwork-php",
    "description": "PHP client for kwork.ru API with WebSocket bot and web-flow helpers.",
    "type": "library",
    "license": "MIT",
    "version": "1.0.0",
    "keywords": ["kwork", "kwork.ru", "api", "freelance", "websocket", "bot"],
    "authors": [
        {
            "name": "kesha1225"
        }
    ],
    "require": {
        "php": "^8.1",
        "guzzlehttp/guzzle": "^7.9",
        "textalk/websocket": "^1.5"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "Kwork\\": "src/"
        },
        "classmap": [
            "src/"
        ],
        "files": [
            "src/Kwork.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Kwork\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit --testdox"
    },
    "minimum-stability": "stable"
}
