{
    "name": "maxbezrod/kwork-php",
    "description": "Sync and async PHP client for kwork.ru API with WebSocket bot, SOCKS proxy, and web-flow helpers.",
    "type": "library",
    "license": "MIT",
    "version": "1.0.0",
    "keywords": [
        "kwork",
        "kwork.ru",
        "api",
        "freelance",
        "websocket",
        "bot",
        "async",
        "socks5",
        "socks4",
        "proxy"
    ],
    "authors": [
        {
            "name": "maxbezrod",
            "homepage": "https://github.com/maxbezrod"
        }
    ],
    "homepage": "https://github.com/maxbezrod/kwork-php",
    "support": {
        "issues": "https://github.com/maxbezrod/kwork-php/issues",
        "source": "https://github.com/maxbezrod/kwork-php"
    },
    "require": {
        "php": "^8.1",
        "guzzlehttp/guzzle": "^7.9",
        "textalk/websocket": "^1.5"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "Kwork\\": "src/"
        },
        "classmap": [
            "src/"
        ],
        "files": [
            "src/Kwork.php",
            "src/AsyncKwork.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Kwork\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit --testdox",
        "generate": [
            "@php tools/generate_openapi_trait.php",
            "@python tools/generate_async_openapi_trait.py"
        ]
    },
    "minimum-stability": "stable"
}
